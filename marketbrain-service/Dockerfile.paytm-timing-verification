FROM maven:3.9.11-eclipse-temurin-21
WORKDIR /verification
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src src
# Populate test dependencies during build; repeat the tests offline with networking disabled at runtime.
RUN mvn -q -Dtest=PaytmApplicationRouteTest,PaytmTimedRouteIntegrationTest,PaytmGatewayTransportTest,PaytmRouteHealthBridgeTest test
CMD ["sh", "-c", "mvn -o -q -Dtest=PaytmApplicationRouteTest,PaytmTimedRouteIntegrationTest,PaytmGatewayTransportTest,PaytmRouteHealthBridgeTest test && java -cp target/test-classes:target/classes in.marketbrain.marketdata.paytm.PaytmTimedRouteReport"]
