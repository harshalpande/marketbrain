FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /verification
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src src
# Spring opt-in and the actual polling/handler contracts are verified without external services.
RUN mvn -q -Dtest=PaperTelegramReviewConfigurationTest,TelegramPaperPollingTest,TelegramUpdateHandlerTest,PaperWriterConnectorTest test dependency:copy-dependencies -DincludeScope=runtime -DoutputDirectory=/verification/lib
FROM eclipse-temurin:21-jre
WORKDIR /verification
COPY --from=build /verification/target/classes /verification/classes
COPY --from=build /verification/lib /verification/lib
ENTRYPOINT ["java", "-Xmx256m", "-cp", "/verification/classes:/verification/lib/*", "in.marketbrain.paper.PaperTelegramVerification"]
