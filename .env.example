# Do not store real values in this repository.
MARKETBRAIN_DB_URL=jdbc:postgresql://host.docker.internal:5432/marketbrain
MARKETBRAIN_DB_USERNAME=marketbrain_app
MARKETBRAIN_DB_PASSWORD=replace-me-locally
MARKETBRAIN_OLLAMA_BASE_URL=http://host.docker.internal:11434
MARKETBRAIN_PAPER_STARTING_CASH=100000
MARKETBRAIN_DUAL_NOTIFICATION_TEST_ENABLED=false

# Keep disabled until Paytm Money Open API access has been approved and tested.
# Never commit a real token.
MARKETBRAIN_PAYTM_ENABLED=false
MARKETBRAIN_PAYTM_BASE_URL=https://developer.paytmmoney.com
MARKETBRAIN_PAYTM_ACCESS_TOKEN=

# Primary read-only market-data provider. Keep the real Analytics Token only in
# the spare laptop's ignored .env file.
MARKETBRAIN_UPSTOX_ENABLED=false
MARKETBRAIN_UPSTOX_BASE_URL=https://api.upstox.com
MARKETBRAIN_UPSTOX_NSE_INSTRUMENT_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
MARKETBRAIN_UPSTOX_ANALYTICS_TOKEN=

# Controlled historical backfill. Leave the worker off until the current NIFTY
# 500 snapshot and a pilot job have been reviewed.
MARKETBRAIN_BACKFILL_WORKER_ENABLED=false
MARKETBRAIN_CURRENT_NIFTY500_URL=https://www.niftyindices.com/IndexConstituent/ind_nifty500list.csv
MARKETBRAIN_NSE_EQUITY_SECURITY_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv
MARKETBRAIN_BACKFILL_WORKER_DELAY_MILLIS=1500
MARKETBRAIN_BACKFILL_MAXIMUM_ATTEMPTS=3
MARKETBRAIN_BACKFILL_MAXIMUM_EXPANSION_BATCH_SIZE=50
MARKETBRAIN_BACKFILL_PILOT_SYMBOLS=INFY,TCS,RELIANCE,HDFCBANK,ICICIBANK,SBIN,ITC,HINDUNILVR,LT,BHARTIARTL

# Incremental post-market enrichment. Keep the scheduler disabled until the
# first read-only preview and manually started catch-up run have been reviewed.
MARKETBRAIN_DAILY_ENRICHMENT_SCHEDULER_ENABLED=false
MARKETBRAIN_DAILY_ENRICHMENT_CRON="0 0/15 16-17 * * MON-FRI"
MARKETBRAIN_DAILY_ENRICHMENT_FINAL_ATTEMPT_CRON="0 0 18 * * MON-FRI"
MARKETBRAIN_DAILY_ENRICHMENT_ZONE=Asia/Kolkata
MARKETBRAIN_DAILY_ENRICHMENT_MAXIMUM_CATCHUP_DAYS=366
MARKETBRAIN_DAILY_ENRICHMENT_PROVIDER_WINDOW_START=16:00
MARKETBRAIN_DAILY_ENRICHMENT_PROVIDER_WINDOW_CUTOFF=18:00
MARKETBRAIN_DAILY_ENRICHMENT_READINESS_SYMBOLS=HDFCBANK,INFY,RELIANCE,SBIN,TCS
MARKETBRAIN_DAILY_ENRICHMENT_COMPLETION_MONITOR_DELAY_MILLIS=30000

# Automatic quality-gated point-in-time feature snapshots. Keep disabled and
# activation far in the future until the reviewed handoff preview has passed.
MARKETBRAIN_DAILY_FEATURE_SNAPSHOT_ENABLED=false
MARKETBRAIN_DAILY_FEATURE_SNAPSHOT_ACTIVATION_DATE=9999-12-31
MARKETBRAIN_DAILY_FEATURE_SNAPSHOT_MONITOR_DELAY_MILLIS=30000
MARKETBRAIN_DAILY_FEATURE_SNAPSHOT_MAXIMUM_ATTEMPTS=3

# News intelligence foundation. Keep both switches false until source
# permissions/terms are reviewed and you are ready to start ingestion.
MARKETBRAIN_NEWS_ENABLED=false
MARKETBRAIN_NEWS_LIVE_FETCH_ENABLED=false
MARKETBRAIN_NEWS_MAXIMUM_ARTICLES_PER_DAY=100
MARKETBRAIN_NEWS_REQUEST_TIMEOUT_SECONDS=20
MARKETBRAIN_MARKETAUX_BASE_URL=https://api.marketaux.com/v1/news/all
MARKETBRAIN_MARKETAUX_API_TOKEN=

# Private Telegram bot. Put real values only in the spare laptop's ignored .env.
MARKETBRAIN_TELEGRAM_ENABLED=false
MARKETBRAIN_TELEGRAM_BOT_TOKEN=
MARKETBRAIN_TELEGRAM_PAIRING_CODE=
MARKETBRAIN_TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=20
MARKETBRAIN_TELEGRAM_POLL_DELAY_MILLIS=1000
# Enable only while manually testing fixed, clearly labelled PAPER alerts.
MARKETBRAIN_TELEGRAM_TEST_ALERTS_ENABLED=false

# Optional WhatsApp Cloud API sandbox mirror. The Meta-provided +1 test number
# is for controlled development only. Keep this disabled until the verified
# webhook is exposed through the reviewed public HTTPS ingress. Never commit
# IDs, tokens, app secrets, verify tokens, or personal recipient identifiers.
MARKETBRAIN_WHATSAPP_ENABLED=false
MARKETBRAIN_WHATSAPP_SANDBOX_MODE=true
MARKETBRAIN_WHATSAPP_TEST_ALERTS_ENABLED=false
MARKETBRAIN_WHATSAPP_NOTIFICATIONS_ENABLED=false
MARKETBRAIN_WHATSAPP_GRAPH_VERSION=
MARKETBRAIN_WHATSAPP_PHONE_NUMBER_ID=
MARKETBRAIN_WHATSAPP_WABA_ID=
MARKETBRAIN_WHATSAPP_ACCESS_TOKEN=
MARKETBRAIN_WHATSAPP_APP_SECRET=
MARKETBRAIN_WHATSAPP_VERIFY_TOKEN=
MARKETBRAIN_WHATSAPP_ALLOWED_WA_ID=
